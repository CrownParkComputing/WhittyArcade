# CMake and compiler output
/build*/
/cmake-build-*/
/CMakeFiles/
/CMakeCache.txt
/Makefile
/cmake_install.cmake
/compile_commands.json
*.a
*.debug
*.dll
*.exe
*.o
*.so
/artifact*/
/symbols/

# Test, diagnostic and local cache output
/Testing/
/.cache/
*.log
*.ppm
*.wav

# ROMs, firmware and user cabinet data must never enter source control
/roms/
*.zip
*.7z
*.chd
*.rom
*.bin
*.eeprom
*.nv
*.backup1

# Editor and operating-system metadata
/.idea/
/.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Scratch patches from local experiments
test_patch.diff
test_mirror.diff

# MANX online. The web config is public by design and IS committed - the API
# key names the project and authorises nothing. These are the things that
# genuinely must not be: deploy caches, and any credential that grants
# server-side access to the project.
/web/.firebase/
/web/node_modules/
/web/package-lock.json
firebase-debug.log
firestore-debug.log
*-serviceaccount.json
*-adminsdk-*.json
